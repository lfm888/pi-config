# pi-config 环境变量示例
#
# 用法（二选一）：
#   1) 复制到 ~/.pi-config.env 然后在 ~/.bashrc 里加: source ~/.pi-config.env
#   2) 直接在 ~/.bashrc 里写这些 export
#
# ⚠️ 真正的密钥文件（~/.pi-config.env / .env）已被 .gitignore 排除，不要提交

# ─────────────────────────────────────────────
# GitHub MCP 服务器（必需，否则 github 服务器不可用）
# 生成位置: GitHub → Settings → Developer settings
#          → Personal access tokens → Tokens (classic)
# 需要权限: repo（读写仓库）；如需操作 workflow 再加 workflow
# ─────────────────────────────────────────────
export GITHUB_PERSONAL_ACCESS_TOKEN="在此粘贴你的token，形如 ghp_ 开头的一串字符"

# ─────────────────────────────────────────────
# pi-web-ui（可选）
# ─────────────────────────────────────────────
# 共享访问令牌：设置后浏览器需带 token 才能访问，局域网暴露时建议开启
# export PI_WEB_TOKEN=""

# 监听地址：127.0.0.1 = 仅本机；0.0.0.0 = 允许局域网/容器访问
# export PI_WEB_HOST="127.0.0.1"

# 端口（默认 8787）
# export PI_WEB_PORT="8787"

# 数据目录（默认 <工作目录>/.pi-web）
# export PI_WEB_DATA_DIR=""
