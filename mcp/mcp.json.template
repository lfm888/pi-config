{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "{{HOME||C:/Users/万灵-干眼1}}"],
      "lifecycle": "eager"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "lifecycle": "eager"
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@cyanheads/git-mcp-server@2"],
      "lifecycle": "eager"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1"],
      "lifecycle": "eager"
    }
  }
}